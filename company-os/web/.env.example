# ── Platform AI Keys (optional) ──────────────────────────────────────────────
# Set these to let users run the app without entering their own API keys.
# If set, the app works out-of-the-box. Users can still connect their own keys.

# Anthropic API key — enables Claude as platform AI
ANTHROPIC_API_KEY=sk-ant-api03-...

# OpenAI API key — enables GPT as platform AI
# OPENAI_API_KEY=sk-proj-...

# OpenCode (or any OpenAI-compatible gateway) — used as fallback when above are not set
# OPENCODE_API_KEY=sk-...
# OPENCODE_BASE_URL=https://api.opencode.ai/v1    # base URL of the compatible API
# OPENCODE_MODEL=claude-sonnet-4-6               # model name the API accepts

# ── App Config ────────────────────────────────────────────────────────────────
PORT=3000
SESSION_SECRET=change-this-to-a-random-secret
